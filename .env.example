# ══════════════════════════════════════════════════════════════════════
# ENVIRONMENT EXAMPLE — copy to .env.local for local development.
#
# DOMAIN RULE 🚧
# The client has NOT yet approved or purchased a production domain.
#   • Do NOT set this to a real-looking or guessed URL.
#   • It will be set in Coolify as NEXT_PUBLIC_SITE_URL once the client
#     approves the domain, BEFORE production deployment.
#   • Until then the code falls back to the deployment host / localhost.
# ══════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://your-domain.example
